+
+impl From<Vec<NbtTag>> for NbtList {
+    /// Convert a Vec of `NbtTag` into an `NbtList`.
+    ///
+    /// Items of heterogeneous lists are wrapped in NBT compounds.
+    fn from(tags: Vec<NbtTag>) -> Self {
+        macro_rules! match_homogeneous_list {
+            ($tags:expr, $( $variant:ident => $into_fn:ident),+ $(,)?) => {
+                match $tags.first() {
+                    $(
+                    Some(NbtTag::$variant(_)) => $tags
+                        .into_iter()
+                        .map(|tag| tag.$into_fn())
+                        .collect::<Option<Vec<_>>>()
+                        .map(NbtList::from),
+                    )+
+                    None => None
+                }
+            }
+        }
+
+        let homogeneous_list = match_homogeneous_list!(
+            tags.clone(),
+            Byte => into_byte,
+            Short => into_short,
+            Int => into_int,
+            Long => into_long,
+            Float => into_float,
+            Double => into_double,
+            ByteArray => into_byte_array,
+            String => into_string,
+            List => into_list,
+            Compound => into_compound,
+            IntArray => into_int_array,
+            LongArray => into_long_array
+        );
+
+        if let Some(homogeneous) = homogeneous_list {
+            homogeneous
+        } else {
+            NbtList::from(
+                tags.into_iter()
+                    .map(Into::into)
+                    .collect::<Vec<NbtCompound>>(),
+            )
+        }
+    }
+}
+impl<const N: usize, T: Into<NbtTag>> From<[T; N]> for NbtList {
+    fn from(tags: [T; N]) -> Self {
+        NbtList::from(tags.into_iter().map(Into::into).collect::<Vec<_>>())
+    }
+}
