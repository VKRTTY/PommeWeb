+            let mut entry = archive.by_index(i).map_err(|e| format!("Client jar: {e}"))?;
+            let Some(name) = entry.enclosed_name() else { continue };
+            if entry.is_dir() || !(name.starts_with("assets") || name == Path::new(VERSION_METADATA)) {
