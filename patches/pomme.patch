+
+/// Lists the actual server-provided advancements and requirement progress.
+/// A tree view with vanilla tabs and connectors is separate from this list.
+#[allow(clippy::too_many_arguments)]
+fn build_advancements(
+    elements: &mut Vec<MenuElement>, w: f32, h: f32, cursor: (f32, f32),
+    clicked: bool, gs: f32, toasts: &crate::ui::toast::ToastState, page: usize,
+) -> PauseAction {
+    let rows = toasts.advancement_rows();
+    let fs = common::FONT_SIZE * gs;
+    let count = (((h / gs) - 64.0) / 24.0).floor().max(1.0) as usize;
+    let pages = rows.len().div_ceil(count).max(1);
+    let page = page.min(pages - 1);
+    let panel_width = w.min(360.0 * gs);
+    let title = if rows.is_empty() { "Advancements — no entries from this server".into() }
+        else { format!("Advancements  {}/{}", page + 1, pages) };
+    elements.push(MenuElement::Text {
+        x:w/2.0, y:12.0*gs, text:title, scale:fs, color:WHITE, centered:true,
+    });
+    let trim = |spans: &[crate::ui::text::TextSpan]| -> String {
+        spans.iter().flat_map(|s| s.text.chars()).filter(|c| !c.is_control()).take(56).collect()
+    };
+    for (index, row) in rows.iter().skip(page * count).take(count).enumerate() {
+        let y = (28.0 + index as f32 * 24.0) * gs;
+        let title = trim(&row.display.title);
+        let title = if title.is_empty() { row.id.to_owned() } else { title };
+        let status = if row.total > 0 && row.complete == row.total { "Complete".to_owned() }
+            else { format!("{}/{}", row.complete, row.total) };
+        elements.push(MenuElement::Text {
+            x:(w-panel_width)/2.0+6.0*gs, y, text:format!("{title}  [{status}]"),
+            scale:fs, color:WHITE, centered:false,
+        });
+        elements.push(MenuElement::Text {
+            x:(w-panel_width)/2.0+6.0*gs, y:y+9.0*gs,
+            text:trim(&row.display.description), scale:fs*0.85,
+            color:[0.8,0.8,0.8,1.0], centered:false,
+        });
+    }
+    let y = h - 26.0*gs;
+    for (slot, label, enabled, action) in [
+        (-1.0, "Previous", page>0, PauseAction::ShowAdvancements(page.saturating_sub(1))),
+        (0.0, "Done", true, PauseAction::Back),
+        (1.0, "Next", page+1<pages, PauseAction::ShowAdvancements(page+1)),
+    ] {
+        if common::push_button(elements,cursor,w/2.0+(slot*82.0-39.0)*gs,y,
+            78.0*gs,20.0*gs,gs,fs,label,enabled) && clicked && enabled {
+            return action;
+        }
+    }
+    PauseAction::None
+}
