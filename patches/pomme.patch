+/// The page's `localStorage`, under a `pomme-` prefix: the browser keeps
+/// it per site.
+#[cfg(target_arch = "wasm32")]
+struct WebStore;
+
+#[cfg(target_arch = "wasm32")]
+impl WebStore {
+    fn storage() -> Option<js_sys::Object> {
+        use wasm_bindgen::JsCast;
+        js_sys::Reflect::get(&js_sys::global(), &"localStorage".into())
+            .ok()?
+            .dyn_into()
+            .ok()
+    }
+
+    fn call(name: &str, args: &[&str]) -> Option<wasm_bindgen::JsValue> {
+        use wasm_bindgen::JsCast;
+        let storage = Self::storage()?;
+        let method: js_sys::Function = js_sys::Reflect::get(&storage, &name.into())
+            .ok()?
+            .dyn_into()
+            .ok()?;
+        let args: js_sys::Array = args.iter().map(|a| wasm_bindgen::JsValue::from_str(a)).collect();
+        method.apply(&storage, &args).ok()
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+impl SecretStore for WebStore {
+    fn read(&self, key: &str) -> Option<String> {
+        Self::call("getItem", &[&format!("pomme-{key}")])?.as_string()
+    }
+
+    fn write(&self, key: &str, value: &str) {
+        Self::call("setItem", &[&format!("pomme-{key}"), value]);
+    }
+}
