+    let generation = job.content_gen;
+    let won = claimed
+        .get(job.pos)
+        .try_update(Ordering::AcqRel, Ordering::Acquire, |taken| {
+            (taken < generation).then_some(generation)
+        })
+        .is_ok();
+    let Some(snapshot) = won.then(|| job.snapshot.lock().unwrap().take()).flatten() else {
+        return false;
