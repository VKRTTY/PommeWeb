+    #[test]
+    fn test_nbt_list_from_heterogeneous_tags() {
+        let tags = vec![1i8.to_nbt_tag(), 1i16.to_nbt_tag()];
+
+        let list: NbtList = tags.into();
+
+        assert_eq!(
+            list,
+            NbtList::Compound(vec![1i8.to_nbt_tag().into(), 1i16.to_nbt_tag().into()])
+        );
+    }
+}
