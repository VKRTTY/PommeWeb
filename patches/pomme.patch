+/// A hand-drawn pixel Octocat, rendered without an external icon font.
+pub(super) fn push_github_pixels(
+    elements: &mut Vec<MenuElement>, x: f32, y: f32, size: f32, gs: f32, color: [f32; 4],
+) {
+    const MASK: [u16; 12] = [
+        0b000111111000, 0b001111111100, 0b011011110110, 0b110011110011,
+        0b110000000011, 0b100000000001, 0b100000000001, 0b110000000011,
+        0b111100001111, 0b011011110110, 0b001001110100, 0b000011110000,
+    ];
+    let inset = (size - 12.0 * gs) / 2.0;
+    for (row, bits) in MASK.into_iter().enumerate() {
+        for col in 0..12 {
+            if bits & (1 << (11-col)) != 0 {
+                elements.push(MenuElement::Rect {
+                    x:x+inset+col as f32*gs, y:y+inset+row as f32*gs,
+                    w:gs, h:gs, corner_radius:0.0, color,
+                });
+            }
+        }
+    }
+}
+
